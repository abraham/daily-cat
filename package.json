{
  "name": "daily-cat",
  "version": "1.0.0",
  "description": "A Firebase Function that serves daily cat images from the Unsplash API",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^22.20.5",
    "@vitest/ui": "^5.1.0",
    "firebase-tools": "^15.35.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "rollup": "^4.68.2",
    "rollup-plugin-copy": "^3.5.0",
    "syncpack": "^15.3.3",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "firebase emulators:exec \"npm start --prefix functions\" --import=seed --ui",
    "build": "npm run build --prefix functions && rollup -c",
    "deploy": "firebase deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix",
    "postinstall": "npm ci --prefix functions",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "firebase": "^13.2.0"
  }
}
